datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id    String @id @default(uuid())
  name  String
  users User[]
}

model User {
  id        String @id @default(uuid())
  email     String @unique
  password  String
  role      String
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
}

model Journal {
  id        String @id @default(uuid())
  debit     Float
  credit    Float
  tenantId  String
  createdAt DateTime @default(now())
}

model Employee {
  id        String @id @default(uuid())
  name      String
  salary    Float
  tenantId  String
}

model Inventory {
  id        String @id @default(uuid())
  name      String
  quantity  Int
  threshold Int
  tenantId  String
}